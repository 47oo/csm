# CSM Backend 本地开发环境变量示例
# 复制为 .env 后按需修改（.env 已被 .gitignore 忽略，不得提交真实密码）。

# 运行环境：dev | test | prod
# dev / test 会挂载非产品自检面 /_foundation/*；prod 不挂载（返回 404）。
CSM_ENVIRONMENT=dev

# 数据库连接串（PostgreSQL，UTF-8）。
# docker-compose.dev.yml 提供的本地实例默认值如下。
CSM_DATABASE_URL=postgresql+psycopg://csm:csm@localhost:5432/csm

# 连接池（可选，见 app/config.py 默认值）
# CSM_DB_POOL_SIZE=5
# CSM_DB_MAX_OVERFLOW=10
# CSM_DB_POOL_TIMEOUT=30
# CSM_DB_ECHO=false