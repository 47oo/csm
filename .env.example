# CSM environment example — PLACEHOLDERS ONLY, never real credentials.
# Copy to `.env` and fill in real values. `.env` is git-ignored and must not
# be committed (requirements §22/§30).

# --- PostgreSQL ---
POSTGRES_USER=csm
POSTGRES_PASSWORD=__SET_ME__
POSTGRES_DB=csm

# --- Backend ---
# SQLAlchemy URL; host `db` is the Compose service name.
DATABASE_URL=postgresql+psycopg://csm:__SET_ME__@db:5432/csm
APP_ENV=development
API_PORT=8000
LOG_LEVEL=INFO
DISPLAY_TIMEZONE=UTC

# --- Connection pool / timeouts (skeleton, DB-D8) ---
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=1800
DB_POOL_TIMEOUT=30
DB_STATEMENT_TIMEOUT_MS=30000
DB_LOCK_TIMEOUT_MS=5000
DB_APPLICATION_NAME=csm-backend

# --- Entry proxy ---
NGINX_HTTP_PORT=80

# --- F002 authentication (placeholders only; never commit real values) ---
# Absolute session lifetime in hours (no sliding renewal).
SESSION_TTL_HOURS=12
# One-shot initial ADMIN created by the Compose `bootstrap` service.
# Leave blank to make bootstrap fail fast (exit 2) on an empty users table.
INITIAL_ADMIN_USERNAME=__SET_ME__
INITIAL_ADMIN_PASSWORD=__SET_ME__
# Extra origins accepted as same-origin for the CSRF check (comma-separated).
AUTH_ALLOWED_ORIGINS=

# --- Integration tests (TEST ONLY) ---
# Independent PostgreSQL test database; the name MUST contain "test" and MUST
# differ from DATABASE_URL. Example when using a locally published PG:
# TEST_DATABASE_URL=postgresql+psycopg://csm:__SET_ME__@localhost:5432/csm_test
TEST_DATABASE_URL=