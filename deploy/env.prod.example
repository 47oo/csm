# ============================================================================
# CSM V1 生产内网部署环境变量模板
#
# 用法：
#   cp deploy/env.prod.example /etc/csm/csm.env
#   # 编辑 /etc/csm/csm.env，填入真实值（该文件不得提交到版本库）
#   docker compose -f docker-compose.prod.yml --env-file /etc/csm/csm.env up -d
#
# ⚠️ 本模板**只含变量名与说明，值为空**，不能用于认证任何实例。
#    口令必须是 URL-safe 字符（或 URL 编码），因为应用 DSN 由这些变量插值组装。
# ============================================================================

# PostgreSQL 初始化账号（三者必须与 DSN 组装一致）。
CSM_POSTGRES_USER=
CSM_POSTGRES_PASSWORD=
CSM_POSTGRES_DB=

# nginx 对外发布的宿主端口（Internal IP + HTTP）。未设置时默认 80。
# CSM_HTTP_PORT=80